rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── สลิปค่าใช้จ่ายเพิ่มเติม ────────────────────────────────────────────
    // path: expenseSlips/{lineUserId}/{fileName}  (freelancer upload)
    //       expenseSlips/{freelancerId}/{fileName} (admin create payment)
    // ไม่ใช้ firestore.get() cross-lookup เพราะมี race condition
    match /expenseSlips/{folderId}/{fileName} {
      // Admin อ่านได้เสมอ; LIFF user อ่านได้ (path รู้ได้แค่จาก payment ของตัวเอง ซึ่ง Firestore คุ้มครองแล้ว)
      allow read: if request.auth != null
        && (
          request.auth.token.firebase.sign_in_provider == 'password'
          || request.auth.token.lineUser == true
        );
      // Admin เขียนได้เสมอ; freelancer เขียนได้เฉพาะ folder ที่ชื่อตรงกับ auth.uid (lineUserId)
      allow write: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (
          request.auth.token.firebase.sign_in_provider == 'password'
          || (request.auth.token.lineUser == true && request.auth.uid == folderId)
        );
    }

    // ── สลิปการโอนเงิน (admin อัพโหลด, freelancer อ่านได้) ────────────────
    // path: payoutSlips/{freelancerId}/{fileName}
    // read: admin หรือ LIFF user ที่ login แล้ว — ไม่ต้อง Firestore cross-lookup
    //   เพราะ path ของสลิปนี้ freelancer รู้ได้แค่จาก payment ของตัวเอง
    //   ซึ่ง Firestore rules บังคับไว้อยู่แล้ว
    match /payoutSlips/{freelancerId}/{fileName} {
      allow read: if request.auth != null
        && (
          request.auth.token.firebase.sign_in_provider == 'password'
          || request.auth.token.lineUser == true
        );
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── รูป profile picture (sync จาก LINE) ────────────────────────────────
    // path: profilePictures/{lineUserId}/profile.jpg
    // admin อ่านได้ทั้งหมด; freelancer อ่าน/เขียนได้เฉพาะ folder ของตัวเอง
    match /profilePictures/{lineUserId}/{fileName} {
      allow read: if request.auth != null
        && (
          request.auth.token.firebase.sign_in_provider == 'password'
          || (request.auth.token.lineUser == true && request.auth.uid == lineUserId)
        );
      allow write: if request.auth != null
        && request.auth.token.lineUser == true
        && request.auth.uid == lineUserId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── รูปสำเนาบัตรประชาชน ────────────────────────────────────────────────
    // path: idCards/{lineUserId}/id_card.{ext}
    // ใช้ lineUserId (= auth.uid) เป็น folder — ตรวจสอบ ownership โดยตรง ไม่ต้อง Firestore cross-lookup
    match /idCards/{lineUserId}/{fileName} {

      // Admin อ่านได้ทั้งหมด; freelancer อ่านได้เฉพาะ folder ของตัวเอง
      // ใช้ auth.uid == lineUserId โดยตรง — ไม่ต้อง Firestore cross-lookup
      allow read: if request.auth != null
        && (
          request.auth.token.firebase.sign_in_provider == 'password'
          || (request.auth.token.lineUser == true && request.auth.uid == lineUserId)
        );

      // Freelancer อัพโหลดได้เฉพาะ folder ของตัวเอง (auth.uid == lineUserId ในชื่อ folder)
      allow write: if request.auth != null
        && request.auth.token.lineUser == true
        && request.auth.uid == lineUserId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

  }
}
