# ─────────────────────────────────────────────────────────────────────────────
# ต่อ tenant (1 บริษัท = 1 Firebase project = 1 ไฟล์นี้)
# ค่า NEXT_PUBLIC_* ถูกฝังลง bundle ตอน build (static export) — ต้องมีตอน build
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# LINE LIFF — ค่า bootstrap เท่านั้น
# ค่าที่ระบบใช้จริงอยู่ใน Firestore publicSettings/line แก้ได้ที่ /admin/settings/line
# ค่านี้ใช้ตอนยังไม่ได้ตั้งใน Firestore (deploy ครั้งแรก) — ตั้งไว้จะสะดวกกว่า
NEXT_PUBLIC_LINE_LIFF_ID=

# Whitelabel
# อีเมล owner ตั้งต้น — ถือเป็น owner เสมอแม้ยังไม่มี doc ใน adminUsers
# (แก้ปัญหาไก่กับไข่ตอนตั้งระบบใหม่) ต้องตรงกับ BOOTSTRAP_OWNER_EMAIL ใน functions/.env
# ปล่อยว่าง = ไม่มี bootstrap owner
NEXT_PUBLIC_BOOTSTRAP_OWNER_EMAIL=

# หมายเหตุ: ชื่อระบบ / โลโก้ / สี ไม่ได้อยู่ในนี้ —
# เก็บใน Firestore `publicSettings/brand` แก้ได้ที่ /admin/settings/brand
# หรือ seed ครั้งแรกด้วย: node scripts/seed-brand.mjs --name "..." --color "#..."
