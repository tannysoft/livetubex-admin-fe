# ─────────────────────────────────────────────────────────────────────────────
# functions/.env — ค่าต่อ tenant (คัดลอกเป็น functions/.env ก่อน deploy)
# ค่าลับ (RESEND_API_KEY / MAIL_FROM / MAIL_TO / LINE_CHANNEL_ACCESS_TOKEN)
# ตั้งด้วย `firebase functions:secrets:set` ไม่ใช่ไฟล์นี้
# ─────────────────────────────────────────────────────────────────────────────

# โดเมนที่เรียก callable functions ได้ คั่นด้วย comma (ตัวแรกใช้ทำลิงก์ในอีเมล)
# ไม่ตั้ง → ใช้ https://{projectId}.web.app และ https://{projectId}.firebaseapp.com
APP_ORIGINS=https://example-admin.web.app,https://console.example.com

# LIFF ID fallback — ค่าจริงอ่านจาก Firestore publicSettings/line (/admin/settings/line)
# ตั้งไว้เผื่ออ่าน Firestore ไม่ได้
LINE_LIFF_ID=

# LINE Login channel ID fallback — ใช้ตรวจว่า access token ออกโดย channel ของ tenant นี้
# ว่างไว้ = derive จาก prefix ของ LIFF ID ให้อัตโนมัติ
# ⚠️ หาไม่เจอทั้งคู่ = freelancer login ไม่ได้ (fail closed โดยตั้งใจ)
LINE_LOGIN_CHANNEL_ID=

# อีเมล owner ตั้งต้น — ต้องตรงกับ NEXT_PUBLIC_BOOTSTRAP_OWNER_EMAIL ฝั่ง frontend
BOOTSTRAP_OWNER_EMAIL=

# ชื่อ/สีที่ใช้ตอนอ่าน publicSettings/brand ไม่ได้ (ยังไม่ได้ seed)
APP_NAME=
BRAND_COLOR=#f73727
